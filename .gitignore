target/
.env
.idea/
*.iml
.classpath
.project
.settings/
.DS_Store
*.log
tools/japicmp-output/

# scripts/*.py. .ruff_cache/ needs no entry: ruff writes a self-ignoring
# .gitignore inside it.
__pycache__/
*.pyc

# OpenTofu (opentofu/). State lives in the flink-gcp-opentofu GCS bucket;
# local state files only ever exist mid-bootstrap and must never be committed.
# *_override.tf is the uncommitted local-backend override the bootstrap uses
# (see opentofu/README.md).
.terraform/
*.tfstate
*.tfstate.*
*_override.tf

# Hugo documentation site build output
docs/public/
docs/resources/
docs/.hugo_build.lock

# Generated API reference (`just docs-javadoc`).
docs/static/api/
