<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-bigquery</artifactId>
    <name>Flink Connectors GCP : BigQuery</name>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- The whole Table API surface this module compiles against: the factory SPI, the
                 DynamicTableSink abilities and the RowData data structures. Nothing else from the
                 Table stack is needed at compile time; ConfigOption comes from flink-core, which
                 is already a dependency. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared connector infrastructure: the retry schedule and status-code
             extraction (#61). -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquerystorage</artifactId>
        </dependency>
        <dependency>
            <!-- The REST client: table metadata and load jobs, and the Schema type
                 JsonDocumentSerializer accepts — so this is on the module's public API.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquery</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: protobuf types (ByteString, Descriptors) are part of this
                 module's public API surface. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- JsonFormat for JSON-mapped columns. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>
        <dependency>
            <!-- ApiFuture types used on the writer's public/internal surface.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <!-- com.google.rpc types (AppendRowsResponse.getError) used in main and tests.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-common-protos</artifactId>
        </dependency>
        <dependency>
            <!-- ApiException/StatusCode for NOT_FOUND classification in the writer.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>
        <dependency>
            <!-- GrpcStatusCode and the plaintext channel provider, for the emulator branch of the
                 Storage Write API paths (emulatorEndpoint). Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
        </dependency>
        <dependency>
            <!-- StatusRuntimeException for NOT_FOUND classification in the writer, and
                 ManagedChannelBuilder for the emulator's plaintext channel.
                 Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <!-- GCS staging for the FILE_LOADS write method.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>
        <dependency>
            <!-- Avro staging files for the FILE_LOADS write method, and the record type of
                 AvroRecordSerializer — so this is on the module's public API. -->
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <dependency>
            <!-- The zstd codec FILE_LOADS stages with. Avro declares this `optional`, so nothing
                 brings it transitively and a missing declaration would surface as a
                 ClassNotFoundException on a TaskManager the first time a staging file is opened,
                 not at build time. Runtime only: no connector source names a zstd type. -->
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- JSONObject, the parameter type JsonToProtoMessage takes; JsonSerializer parses
                 its String records into one. Reaches us transitively from
                 google-cloud-bigquerystorage anyway, but is used directly, so it is declared.
                 Not on this module's public API: records are plain Strings. -->
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Shared test utilities (#27). -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Emulator-based integration tests (goccy/bigquery-emulator). -->
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FactoryMocks, for driving the table factory without a planner. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TableEnvironment for the SQL integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The planner behind those TableEnvironments. The loader form is the one the
                 connector parent's enforcer permits. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RowData runtime types the planner-generated code needs at test runtime. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MiniCluster-based FILE_LOADS integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the streaming FILE_LOADS
                 integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Compiles src/test/protobuf into test-only Java. The fixtures these
                     tests need — oneof, proto3 optional, proto2 required, the wrapper
                     types — are a few lines of ordinary proto each and were pages of
                     DescriptorProtos builder calls before (#132). Test scope only:
                     nothing in src/main uses protoc, and the generated classes are not
                     packaged.

                     protoc itself is resolved from Maven Central as
                     com.google.protobuf:protoc:${protoc.version}:exe:<platform>, so a
                     fresh checkout builds with nothing installed and CI needs no extra
                     tool. See the note on protoc.version in the parent pom for which
                     way the version constraint runs. -->
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <!-- A bare version number here means "resolve
                         com.google.protobuf:protoc:<version>:exe:<platform> from the
                         repository", which is what keeps protoc off PATH. -->
                    <protoc>${protoc.version}</protoc>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-test-protobuf</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
