<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-bigquery</artifactId>
    <name>Flink Connectors GCP : BigQuery</name>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- The whole Table API surface this module compiles against: the factory SPI, the
                 DynamicTableSink abilities and the RowData data structures. Nothing else from the
                 Table stack is needed at compile time; ConfigOption comes from flink-core, which
                 is already a dependency. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- One type: GenericRecordAvroTypeInfo, which is what the source's GenericRecord
                 deserializer answers getProducedType() with. Without it Flink types GenericRecord
                 as a generic type backed by Kryo, and Kryo cannot serialize one at all - it fails
                 on the record's own schema (measured 2026-08-09). Provided rather than compile
                 because a job reading GenericRecords needs flink-avro on its classpath either
                 way, and bundling a second copy beside the deployment's own is what the SQL
                 uber-jar exists to prevent. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-avro</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared connector infrastructure: the retry schedule and status-code
             extraction (#61). -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquerystorage</artifactId>
        </dependency>
        <dependency>
            <!-- The REST client: table metadata and load jobs, and the Schema type
                 JsonDocumentSerializer accepts — so this is on the module's public API.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquery</artifactId>
        </dependency>
        <dependency>
            <!-- The high-level client does not expose If-Match for table patches. CDC uses its
                 configured transport directly for the conditional label transition. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-core-http</artifactId>
        </dependency>
        <dependency>
            <!-- HTTP request types used by the conditional CDC label patch. -->
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client</artifactId>
        </dependency>
        <dependency>
            <!-- JSON request encoding for the conditional CDC label patch and Debezium sequence
                 parsing. -->
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-gson</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: protobuf types (ByteString, Descriptors) are part of this
                 module's public API surface. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- JsonFormat for JSON-mapped columns. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>
        <dependency>
            <!-- ApiFuture types used on the writer's public/internal surface.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <!-- com.google.rpc types (AppendRowsResponse.getError) used in main and tests.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-common-protos</artifactId>
        </dependency>
        <dependency>
            <!-- ApiException/StatusCode for NOT_FOUND classification in the writer.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>
        <dependency>
            <!-- GrpcStatusCode and the plaintext channel provider, for the emulator branch of the
                 Storage Write API paths (emulatorEndpoint). Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
        </dependency>
        <dependency>
            <!-- StatusRuntimeException for NOT_FOUND classification in the writer, and
                 ManagedChannelBuilder for the emulator's plaintext channel.
                 Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <!-- GCS staging for the FILE_LOADS write method.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>
        <dependency>
            <!-- Avro staging files for the FILE_LOADS write method, and the record type of
                 AvroRecordSerializer — so this is on the module's public API. -->
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <!--
            What a deployment must add beside hadoop-common for a COMPRESSED Parquet staging file,
            measured by adding them back one at a time until the writer ran. Test scope, because
            the connector needs none of it unless the user selects Parquet with a codec — and
            keeping the list here means the test classpath is the demonstration of that minimum
            rather than prose that can go stale.
        -->
        <dependency>
            <!-- Reading a Parquet file needs more Hadoop than writing one: ParquetFileReader.open
                 reaches ParquetInputFormat, which extends Hadoop's FileInputFormat. Test scope
                 only — the connector never reads what it stages — and it buys the assertion that
                 the staged schema carries a three-level LIST, whose absence would load every
                 REPEATED column as an empty array with no error. -->
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-core</artifactId>
            <version>${hadoop.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop.thirdparty</groupId>
            <artifactId>hadoop-shaded-guava</artifactId>
            <version>1.5.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-configuration2</artifactId>
            <version>2.15.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The optional Parquet staging path (#284), NOT shipped. `provided` because a
                 deployment that selects StagingFormat.PARQUET supplies it, and every other
                 deployment should not carry it: parquet-avro pulls the parquet family and, for any
                 compression at all, a Hadoop runtime. FileLoadsOptions.build() probes for both on
                 the client so a missing one fails at graph construction with the artifact named,
                 rather than on a TaskManager when the first staging file is opened. -->
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-avro</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Compile-only, and not because the connector calls Hadoop: AvroParquetWriter's own
                 imports name org.apache.hadoop.conf.Configuration and org.apache.hadoop.fs.Path,
                 so javac needs them to resolve the builder's overloads. At run time only
                 ParquetCompression.NONE avoids Hadoop — every codec in parquet-hadoop resolves
                 through Hadoop's CompressionCodec SPI (measured). -->
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- The zstd codec FILE_LOADS stages with. Avro declares this `optional`, so nothing
                 brings it transitively and a missing declaration would surface as a
                 ClassNotFoundException on a TaskManager the first time a staging file is opened,
                 not at build time. Runtime only: no connector source names a zstd type. -->
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- JSONObject, the parameter type JsonToProtoMessage takes; JsonSerializer parses
                 its String records into one. Reaches us transitively from
                 google-cloud-bigquerystorage anyway, but is used directly, so it is declared.
                 Not on this module's public API: records are plain Strings. -->
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Shared test utilities (#27). -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Emulator-based integration tests (goccy/bigquery-emulator). -->
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FactoryMocks, for driving the table factory without a planner. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TableEnvironment for the SQL integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The planner behind those TableEnvironments. The loader form is the one the
                 connector parent's enforcer permits. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RowData runtime types the planner-generated code needs at test runtime. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MiniCluster-based FILE_LOADS integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the streaming FILE_LOADS
                 integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Compiles src/test/protobuf into test-only Java. The fixtures these
                     tests need — oneof, proto3 optional, proto2 required, the wrapper
                     types — are a few lines of ordinary proto each and were pages of
                     DescriptorProtos builder calls before (#132). Test scope only:
                     nothing in src/main uses protoc, and the generated classes are not
                     packaged.

                     protoc itself is resolved from Maven Central as
                     com.google.protobuf:protoc:${protoc.version}:exe:<platform>, so a
                     fresh checkout builds with nothing installed and CI needs no extra
                     tool. See the note on protoc.version in the parent pom for which
                     way the version constraint runs. -->
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <!-- A bare version number here means "resolve
                         com.google.protobuf:protoc:<version>:exe:<platform> from the
                         repository", which is what keeps protoc off PATH. -->
                    <protoc>${protoc.version}</protoc>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-test-protobuf</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
