<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-bigquery</artifactId>
    <name>Flink Connectors GCP : BigQuery</name>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquerystorage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquery</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: protobuf types (ByteString, Descriptors) are part of this
                 module's public API surface. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- JsonFormat for JSON-mapped columns. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>
        <dependency>
            <!-- ApiFuture types used on the writer's public/internal surface.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <!-- com.google.rpc types (AppendRowsResponse.getError) used in main and tests.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-common-protos</artifactId>
        </dependency>
        <dependency>
            <!-- ApiException/StatusCode for NOT_FOUND classification in the writer.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>
        <dependency>
            <!-- StatusRuntimeException for NOT_FOUND classification in the writer.
                 Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <!-- GCS staging for the FILE_LOADS write method.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>
        <dependency>
            <!-- Avro staging files for the FILE_LOADS write method, and the record type of
                 AvroRecordSerializer — so this is on the module's public API. -->
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Emulator-based integration tests (goccy/bigquery-emulator). -->
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Plaintext gRPC channel setup against the emulator in integration tests.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MiniCluster-based FILE_LOADS integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the streaming FILE_LOADS
                 integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
