<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-pubsub</artifactId>
    <name>Flink Connectors GCP : Pub/Sub</name>
    <description>Independent Google Cloud Pub/Sub connector for Apache Flink. Not affiliated with the Apache Software Foundation or Google.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- The whole Table API surface this module compiles against: the factory SPI,
                 the DynamicTableSink/Source abilities, the format interfaces and the RowData
                 data structures (including ProjectedRowData). Nothing else from the Table
                 stack is needed at compile time; ConfigOption comes from flink-core, which
                 is already a dependency. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- DataStreamSinkProvider, used by the table sink to insert ordering-key routing
                 before the Sink V2 writer. Flink distributions provide this API through
                 flink-table-api-java-uber; keeping this dependency provided also keeps it out of
                 the connector's SQL uber-jar. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared connector infrastructure: the retry schedule and status-code
             extraction (#61). -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-pubsub</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: PubsubMessage/TopicName are part of this module's public API
                 surface (serialization schema, topic destination). Version managed by the
                 libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-pubsub-v1</artifactId>
        </dependency>
        <dependency>
            <!-- ByteString on the payload serialization adapter's API path.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- ApiFuture types used on the writer's internal surface and in tests.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <!-- ApiException/StatusCode for NOT_FOUND classification and AlreadyExistsException
                 in the topic admin. Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>
        <dependency>
            <!-- StatusRuntimeException on the writer's NOT_FOUND classification path.
                 Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <!-- Plaintext gRPC channel setup for the emulator endpoint mode of the publisher
                 factory and the topic admin. Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Shared test utilities (#27). -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Emulator-based integration tests (PubSubEmulatorContainer). -->
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MiniCluster-based streaming integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the streaming integration test. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FactoryMocks, for driving the table factory without a planner. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The planner behind those TableEnvironments. The loader form is the one the
                 connector parent's enforcer permits. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RowData runtime types the planner-generated code needs at test runtime. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The format the table tests encode with. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- A second format, so "any format resolves" is tested rather than assumed. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-csv</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
