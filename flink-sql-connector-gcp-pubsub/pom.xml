<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-sql-connector-gcp-pubsub</artifactId>
    <name>Flink Connectors GCP : SQL : Pub/Sub</name>
    <packaging>jar</packaging>

    <properties>
        <!-- This module has no source of its own; its public surface is the connector's,
             checked there. japicmp would compare a relocated uber-jar against itself. -->
        <japicmp.skip>true</japicmp.skip>
    </properties>

    <dependencies>
        <!-- The only compile dependency, and the reason this module exists: it is bundled
             along with its whole runtime tree. Nothing here references it from source,
             which is why maven-dependency-plugin:analyze has to be told to ignore it. -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-pubsub</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test scope. The integration tests run against the shaded jar rather than
             against these classes (see the surefire configuration below), so what is
             needed here is a Flink able to plan and run a SQL job, plus the emulator. -->
        <dependency>
            <!-- Shared test utilities (#27): the emulator container image and the stock
                 admin/pull clients the smoke test drives the emulator with. -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The FLIP-27 source base the connector compiles against as `provided`. It ships in
             flink-dist, so it is not bundled here either — but the test classpath is not a
             Flink distribution and has to supply it. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The format the smoke test's DDL asks for. A shaded jar that cannot be
             combined with a stock format would be useless, so this exercises the
             discovery path too. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-json</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The emulator. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The test harness also drives the emulator with the *unshaded* Pub/Sub admin
             client, so that the connector's relocated copy and a stock one demonstrably
             coexist on one classpath. Those classes are NOT declared here on purpose:
             they arrive transitively from the connector at compile scope, and a direct
             `test` declaration would win by Maven's nearest-definition rule and demote
             them out of the shaded bundle. Measured — it silently cut the uber-jar from
             the full runtime tree down to guava plus a handful of annotation jars.
             `maven-dependency-plugin:analyze` is deliberately absent for the same reason:
             the scoping it would demand is exactly the scoping that breaks the bundle. -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- No <version>: 3.6.1 comes from the connector parent's pluginManagement,
                     along with the `shade-flink` execution's phase, goal, shadeTestJar,
                     shadedArtifactAttached and dependency-reduced-pom settings. Reusing that
                     execution id is what inherits them. -->
                <executions>
                    <execution>
                        <id>shade-flink</id>
                        <configuration>
                            <!-- `*:*`: everything on the runtime classpath, which is the
                                 bundle by definition — Flink is `provided` and test scope never
                                 reaches shade, so nothing else can match. This replaced an
                                 enumerated include list whose justifications died one by one,
                                 each measured: an unlisted new transitive does NOT fail the
                                 build (it is silently dropped, the worst outcome available),
                                 and "keeps the NOTICE readable beside it" ended when the NOTICE
                                 became generated from the resolved tree. With the wildcard a
                                 new dependency lands in the jar automatically; what still needs
                                 a human is the licensing gate (`just update-notice`) and, for a
                                 genuinely new package root, the relocation list — and the
                                 packaging tests fail with the artifact's name for both. -->
                            <artifactSet>
                                <includes>
                                    <include>*:*</include>
                                </includes>
                            </artifactSet>

                            <relocations>
                                <!-- Everything a user's own job could carry a different version
                                     of, with no exception. -->
                                <relocation>
                                    <pattern>com.google</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.com.google</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.grpc</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.io.grpc</shadedPattern>
                                </relocation>

                                <!-- io.grpc:grpc-netty-shaded has been relocated once already, by
                                     gRPC's own build, which renamed META-INF/native/libnetty* to
                                     libio_grpc_netty_shaded_netty* to match. Netty derives the
                                     native library name at runtime from the package prefix of its
                                     own NativeLibraryLoader, and maven-shade does not rename
                                     native resources — so relocating those classes a second time
                                     without these two entries leaves the classes looking under
                                     the new prefix while the files sit under the old one. Both
                                     forms are needed: Windows DLLs carry no `lib`.

                                     This is the established form, not an invention. Identical
                                     pairs appear in googleapis/java-bigtable-hbase (which cites
                                     netty#6995 and grpc-java#2485), GoogleCloudDataproc's
                                     gcs-connector, and the uber-jars of both Google Flink
                                     connectors; Beam and spark-bigquery do the same thing with
                                     their own prefixes. maven-shade matches resource paths
                                     directly, so no `rawString` is required — and none of those
                                     projects uses it. The counterexample is
                                     GoogleCloudDataproc/flink-bigquery-connector, which relocates
                                     io.grpc without renaming and ships a jar whose tcnative and
                                     epoll libraries can never load.

                                     The replacement is not free-form: netty's
                                     calculateMangledPackagePrefix() takes its own class name
                                     minus io.netty.util.internal.NativeLibraryLoader and maps
                                     `_` to `_1` then `.` to `_`. So the relocated name must stay
                                     a pure *prefix* of that suffix — collapsing the middle throws
                                     UnsatisfiedLinkError at class init — and an underscore in the
                                     prefix would have to be written `_1`. This prefix has none.
                                     PubSubSqlConnectorPackagingITCase derives the same string
                                     from the shaded prefix, so the two cannot drift apart.

                                     Leaving grpc-netty-shaded unrelocated was built and rejected:
                                     it makes this jar unable to share a classpath with any other
                                     jar carrying io.grpc.netty.shaded — including a future GCP SQL
                                     connector built the same way, whose copy would extend a
                                     differently relocated gRPC core. The failure is
                                     "NettyChannelProvider not a subtype", observed in a real test
                                     run, and it is exactly what an uber-jar exists to prevent.

                                     Untested residue: whether the renamed libraries load through
                                     JNI is only exercised on Linux with epoll or tcnative, which
                                     the plaintext emulator test never reaches. A wrong rename
                                     degrades to NIO and JDK SSL silently rather than failing. -->
                                <relocation>
                                    <pattern>META-INF/native/libio_grpc_netty_shaded_netty</pattern>
                                    <shadedPattern>META-INF/native/libio_github_flink_gcp_connector_pubsub_shaded_io_grpc_netty_shaded_netty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>META-INF/native/io_grpc_netty_shaded_netty</pattern>
                                    <shadedPattern>META-INF/native/io_github_flink_gcp_connector_pubsub_shaded_io_grpc_netty_shaded_netty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.opencensus</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.io.opencensus</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.opentelemetry</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.io.opentelemetry</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.perfmark</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.io.perfmark</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.threeten</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.org.threeten</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.http</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.org.apache.http</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.codec</pattern>
                                    <shadedPattern>io.github.flink.gcp.connector.pubsub.shaded.org.apache.commons.codec</shadedPattern>
                                </relocation>
                                <!-- Not relocated, and each for a reason:

                                     org.conscrypt — ships native libraries under META-INF/native
                                       named after its own package, the same hazard handled above
                                       for netty. Unlike netty it is a leaf: nothing here links
                                       against it, gRPC only picks it up reflectively as an
                                       optional TLS provider, and it falls back to JDK SSL when
                                       absent or unusable. So the rename dance buys nothing here.

                                     javax.annotation (jsr305 and javax.annotation-api),
                                     org.jspecify, org.codehaus.mojo.animal_sniffer,
                                     android.annotation — annotation-only artifacts. Relocation
                                       exists to stop two versions of a *behaving* class fighting
                                       over one name; a duplicate annotation class is inert,
                                       resolved by whichever loader wins and never invoked. So
                                       relocating buys nothing, and for javax.annotation it would
                                       mean rewriting a standard JSR package, which is a surprise
                                       nobody asked for.

                                     PubSubSqlConnectorPackagingITCase carries the matching
                                     allow-list, so this list and that one fail together. -->
                            </relocations>

                            <!-- MUST append: the parent's plugin-level filters carry the
                                 log4j/signature/META-INF-maven excludes, and MSHADE-305 means
                                 merging filters rather than appending them misbehaves. -->
                            <filters combine.children="append">
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Bundled jars' own top-level licence files would land on
                                             top of each other at the jar root. The licences are
                                             carried deliberately in META-INF/licenses/ instead. -->
                                        <exclude>LICENSE</exclude>
                                        <exclude>LICENSE.txt</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <!-- Overrides the parent's, which names the project "Apache Flink".
                                 Left alone it would stamp ASF provenance onto an artifact this
                                 project does not publish under the ASF. combine.self="override"
                                 because the parent declares its <transformers> with
                                 combine.children="append" — without it we would get both.

                                 The cost of overriding: this list must stay a superset of the
                                 parent's. It is one today (ServicesResourceTransformer and the
                                 notice transformer are all it declares), but a transformer added
                                 in a future flink-connector-parent would not reach this module,
                                 and nothing would say so. -->
                            <transformers combine.self="override">
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <projectName>GCP Connectors for Apache Flink</projectName>
                                    <!-- organizationName and inceptionYear are separate from
                                         projectName and default to the ASF and 2006 — setting
                                         only the project name still yields "Copyright 2006-2026
                                         The Apache Software Foundation". Measured, not assumed. -->
                                    <organizationName>laughingman7743</organizationName>
                                    <organizationURL>https://github.com/laughingman7743</organizationURL>
                                    <inceptionYear>2026</inceptionYear>
                                    <encoding>UTF-8</encoding>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Resolves each bundled dependency's declared licence into
                 target/generated-sources/license/THIRD-PARTY.txt, which
                 scripts/check-notice.py diffs against META-INF/NOTICE. All the
                 configuration is inherited from the root pom's pluginManagement, so a
                 sibling SQL module needs exactly this much.

                 Bound to a phase rather than invoked as a bare goal, which was tried
                 and fails in CI: a goal invocation does not build reactor siblings, so
                 `-pl` here cannot resolve the connector — not even with `-am` — unless
                 a previous `install` happened to leave it in the local repository. A
                 phase builds them. It costs almost nothing to run every time: the goal
                 reads POMs Maven has already resolved and does not fetch licence texts
                 (that is `download-licenses`, which this project deliberately does not
                 use — see scripts/check-notice.py). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>record-resolved-licences</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <!-- No <version> here either, but the source differs from the shade plugin's:
                     this one resolves to 3.1.1 from org.apache:apache:20, the ASF grandparent,
                     rather than from flink-connector-parent. Pinned there, so reproducible. -->
                <executions>
                    <!-- The input to BundledDependenciesNoticeTest: the exact runtime tree
                         that ends up in the jar, written where a test can read it. This is
                         what turns a libraries-bom bump that adds a transitive into a build
                         failure rather than a silently missing class. -->
                    <execution>
                        <id>record-runtime-dependencies</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>list</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputScope>false</outputScope>
                            <sort>true</sort>
                            <outputFile>${project.build.directory}/runtime-dependencies.txt</outputFile>
                        </configuration>
                    </execution>
                    <!-- The same tree as file paths, so a test can open each artifact and check
                         its classes really landed in the uber-jar. The NOTICE diff cannot: it
                         compares the dependency tree against a text file, and an artifact missing
                         from artifactSet/includes is present in both of those and absent only
                         from the jar. -->
                    <execution>
                        <id>record-runtime-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- Redeclares the parent's integration-test execution so the ITs run
                         against the *shaded* jar. Dropping the connector artifact and adding
                         the uber-jar is what makes "the connector class came from the uber-jar"
                         true rather than hoped for; the smoke test asserts it as well, since a
                         silent regression here would leave the test passing against unshaded
                         classes and proving nothing.

                         The connector's transitive Google artifacts stay: the harness drives the
                         emulator with them while the connector uses its relocated copies, and
                         that coexistence is the point. -->
                    <execution>
                        <id>integration-tests</id>
                        <configuration>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>io.github.flink-gcp:flink-connector-gcp-pubsub</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/${project.build.finalName}.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
