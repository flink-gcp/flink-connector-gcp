<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-bigtable</artifactId>
    <name>Flink Connectors GCP : Bigtable</name>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared connector infrastructure: the failure-handler SPI (#37). -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <!-- The data client, its RowMutationEntry — which is the serialization schema's
                 return type, and so part of this module's public API surface — and the
                 admin client, which table auto-creation creates through and the emulator
                 tests create tables with. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigtable</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: MutateRowsRequest.Entry is what a failed mutation carries as
                 its dead-letter payload, and the row key is read from it — RowMutationEntry
                 exposes neither. Version managed by the libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-bigtable-v2</artifactId>
        </dependency>
        <dependency>
            <!-- ByteString on the failed-mutation payload and on row keys.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- The per-entry ApiFuture the batcher returns, and its callback types.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <!-- StatusCode for the writer's per-entry failure classification, and the
                 Batcher the mutation-batcher SPI wraps. Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Shared test utilities (#27). -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MetricListener, reached through test-utils' TestSinkWriterMetricGroup: that
                 module declares flink-test-utils at provided scope, which is non-transitive
                 by design, so every module using the shared writer stubs declares it too. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Building the gax exceptions the writer tests script, which need a transport
                 status code. Test scope, since no main source touches gRPC directly; test-scope
                 declarations are not transitive, so this cannot demote the artifact out of a
                 future SQL uber-jar the way one in the *shaded* module's pom would.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The raw StatusRuntimeException path of the error classifier. Test scope, as
                 gax-grpc above. Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- BigtableEmulatorContainer. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster job integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the job integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
