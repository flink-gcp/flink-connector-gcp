<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-docs-validation</artifactId>
    <name>Flink Connectors GCP : Documentation validation</name>
    <packaging>pom</packaging>

    <properties>
        <!-- Kafka connectors are released independently for each Flink minor. This default
             matches the repository's Flink 2.2 compilation floor; the Flink 1 profile below
             selects the corresponding 1.20 connector. -->
        <flink.kafka.connector.version>5.0.0-2.2</flink.kafka.connector.version>
    </properties>

    <dependencies>
        <!-- The snippets exercise the public DataStream APIs of all five connectors. Test scope
             keeps this internal module from becoming an API dependency aggregator. -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-bigquery</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-pubsub</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-cloudtasks</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-bigtable</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-spanner</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Provided dependencies of a connector are deliberately non-transitive. The Pub/Sub
             example builds a DataStream around its sink, so the validation classpath names the
             Flink APIs it uses directly. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The Debezium Avro SQL bridge registers a changelog DataStream as a table. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Planner implementation used to validate the SQL regions without submitting jobs. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RowData runtime types required while planner operations are translated. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Execution environment classes loaded while TableEnvironment initializes. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Shared source and delivery-guarantee APIs loaded by connector factories. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Source used by the lookup and batch aggregation examples. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Formats resolved by the documented Table API connector options. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-csv</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-avro</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- GenericRecord is part of BigQuery's public Avro serializer boundary. -->
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The Debezium CDC examples show the complete Kafka source boundary. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${flink.kafka.connector.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The Kafka source decodes full Debezium envelopes from Schema Registry. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-avro-confluent-registry</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TiCDC's Debezium protocol is JSON, so its example reads the envelope with the
                 same JSON boundary JsonDocumentSerializationSchema accepts. -->
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Coherent with the jackson-databind avro brings; see jackson-annotations.version
                 in the root POM for why this is declared per module. -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson-annotations.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>flink1-kafka-connector</id>
            <activation>
                <property>
                    <name>flink.compat</name>
                    <value>flink1</value>
                </property>
            </activation>
            <properties>
                <flink.kafka.connector.version>3.4.0-1.20</flink.kafka.connector.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- pom packaging has no default Java lifecycle. Bind test compilation explicitly so
                 test-compile checks the same source files Hugo renders. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-documentation-snippets</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- The module has pom packaging, so bind its own tests explicitly. Running them in
                 test-compile keeps `just check-doc-snippets` as the one SQL validation entrypoint
                 without executing connector-module tests pulled in by `-am`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- The parent binds ordinary *Test classes again at `test`. This module's
                         explicit execution below is the whole test boundary, so disable that
                         inherited execution rather than running every planner scenario twice in
                         the weekly full-profile matrix. -->
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>validate-documentation-sql</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Keep the guard local to the module so an accidentally activated profile in a
                 future release build still cannot upload this validation POM. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
