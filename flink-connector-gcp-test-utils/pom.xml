<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-test-utils</artifactId>
    <name>Flink Connectors GCP : Test Utils</name>
    <packaging>jar</packaging>

    <properties>
        <!-- Test-support code with no compatibility surface of its own; consumers use it
             at test scope only. Exclude this module from publishing when #29/#39 decide
             artifact publishing. -->
        <japicmp.skip>true</japicmp.skip>
    </properties>

    <dependencies>
        <!-- Everything here is provided: these utilities run on the classpath of a
             consumer's tests, which already carries whatever the consumer exercises.
             Provided is also non-transitive, so depending on this module at test scope
             adds no new resolution path to any artifact - which is what keeps the SQL
             uber-jar's shade-scope mediation undisturbed (see that module's notes). -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- SplitReader/RecordsWithSplitIds for the fetch-loop helper. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- MetricListener behind TestSinkWriterMetricGroup, plus the flink-runtime
                 ProxyMetricGroup it extends, which arrives transitively with it. Provided
                 like everything else here, so a module using that helper declares
                 flink-test-utils at test scope itself.

                 log4j-core, which LogCapture is written against, rides along the same way:
                 flink-test-utils -> flink-test-utils-junit (compile) -> log4j-core (compile).
                 Deliberately not declared here. Nothing manages a log4j version - not this
                 build, not flink-connector-parent - so declaring it would pin one by hand,
                 and a pin that drifts from what Flink puts on the runtime classpath fails at
                 runtime rather than at build time. Losing the transitive, by contrast, is a
                 compile error in LogCapture on the next build. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The Bigtable half (testutils.bigtable): the admin and data clients the emulator
             harnesses open. Version managed by the libraries BOM; the container type comes
             from testcontainers' `gcloud` module below, as Pub/Sub's does. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigtable</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The Pub/Sub half (testutils.pubsub). Versions managed by the libraries BOM. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-pubsub</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- PubsubMessage, PullRequest/Response, TopicName. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-pubsub-v1</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ByteString on the publish path. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ApiFuture on the publish path. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- NoCredentialsProvider and the transport-channel-provider types. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- GrpcTransportChannel for the emulator's plaintext channel. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ManagedChannel(Builder) for the emulator's plaintext channel. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- PubSubEmulatorContainer behind the shared image holder. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The BigQuery half (testutils.bigquery). -->
        <dependency>
            <!-- GenericContainer for the goccy emulator, which testcontainers has no
                 module for - unlike Pub/Sub's, whose container type comes from `gcloud`
                 above. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- The stock REST client the emulator harnesses drive the service with. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-bigquery</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- NoCredentials for the emulator's unauthenticated REST client. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The SQL uber-jar half (testutils.sql). These two are declared at `test` scope
             for every module by the root pom, which does not reach src/main/java - the
             abstract packaging and NOTICE test bases live there, so this module needs them
             at compile time. Provided rather than compile for the reason above: a consumer
             already has both at test scope, and adding a transitive path to them would be
             exactly the shade-scope hazard this file's opening comment guards against. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
