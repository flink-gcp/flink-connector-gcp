<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-test-utils</artifactId>
    <name>Flink Connectors GCP : Test Utils</name>
    <packaging>jar</packaging>

    <properties>
        <!-- Test-support code with no compatibility surface of its own; consumers use it
             at test scope only. Exclude this module from publishing when #29/#39 decide
             artifact publishing. -->
        <japicmp.skip>true</japicmp.skip>
    </properties>

    <dependencies>
        <!-- Everything here is provided: these utilities run on the classpath of a
             consumer's tests, which already carries whatever the consumer exercises.
             Provided is also non-transitive, so depending on this module at test scope
             adds no new resolution path to any artifact - which is what keeps the SQL
             uber-jar's shade-scope mediation undisturbed (see that module's notes). -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- SplitReader/RecordsWithSplitIds for the fetch-loop helper. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- MetricListener behind TestSinkWriterMetricGroup, plus the flink-runtime
                 ProxyMetricGroup it extends, which arrives transitively with it. Provided
                 like everything else here, so a module using that helper declares
                 flink-test-utils at test scope itself. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The Pub/Sub half (testutils.pubsub). Versions managed by the libraries BOM. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-pubsub</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- PubsubMessage, PullRequest/Response, TopicName. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-pubsub-v1</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ByteString on the publish path. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ApiFuture on the publish path. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- NoCredentialsProvider and the transport-channel-provider types. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- GrpcTransportChannel for the emulator's plaintext channel. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- ManagedChannel(Builder) for the emulator's plaintext channel. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- PubSubEmulatorContainer behind the shared image holder. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
