<!--
The CI jobs' Maven settings (issue #1887), passed through MAVEN_ARGS. Maven Central
answers GitHub-hosted runners with HTTP 429 often enough to fail a lane that changed
nothing, so every release artifact is read first from Google's mirror of Central. The
mirror is a repository ahead of Central, not a <mirror> of it: an artifact the mirror
has not synced yet still resolves from Central. The release workflow does not use
this file: its Central Portal credentials live in the ~/.m2/settings.xml that
scripts/write-central-settings.sh writes, which a settings file passed here would replace.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <profiles>
        <profile>
            <id>google-maven-central</id>
            <repositories>
                <repository>
                    <id>google-maven-central</id>
                    <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>google-maven-central</id>
                    <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>google-maven-central</activeProfile>
    </activeProfiles>
</settings>
