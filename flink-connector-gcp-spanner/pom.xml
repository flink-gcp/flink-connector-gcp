<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-spanner</artifactId>
    <name>Flink Connectors GCP : Spanner</name>
    <description>Independent Google Cloud Spanner connector for Apache Flink. Not affiliated with the Apache Software Foundation or Google.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Dynamic table factory, RowData and logical types. The Flink distribution
                 supplies this at runtime; the future SQL uber-jar must not bundle it. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared connector infrastructure: the failure-handler SPI (#37), the retry
             schedule (#61), the option checks (#381) and the emulator endpoint. -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <!-- The Spanner client. Its Mutation is the serialization schema's return type,
                 and so part of this module's public API surface; MutationGroup, Dialect and
                 DatabaseClient.batchWriteAtLeastOnce are the write path; the database admin
                 client is what the emulator tests create databases with. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-spanner</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: Change Streams returns JSON in PostgreSQL and JSON-valued
                 fields in GoogleSQL. The record SPI preserves those values and type descriptors
                 without mapping them through the client library's current type enum. Version
                 managed by the libraries BOM. -->
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: BatchWriteResponse is what batchWriteAtLeastOnce streams
                 back, and the writer reads its group indexes and per-group status off it —
                 the client library exposes no wrapper for either. Version managed by the
                 libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-spanner-v1</artifactId>
        </dependency>
        <dependency>
            <!-- com.google.rpc.Status on a BatchWriteResponse, and ByteString on the
                 failed-mutation payload. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dependency: com.google.rpc.Status is generated into this artifact,
                 not into protobuf-java. Version managed by the libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-common-protos</artifactId>
        </dependency>
        <dependency>
            <!-- StatusCode for the writer's failure classification, and the ServerStream
                 batchWriteAtLeastOnce returns. Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Shared test utilities (#27). -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MetricListener, reached through test-utils' TestSinkWriterMetricGroup: that
                 module declares flink-test-utils at provided scope, which is non-transitive
                 by design, so every module using the shared writer stubs declares it too. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Building the gax exceptions the writer tests script, which need a transport
                 status code. Test scope, since no main source touches gRPC directly; test-scope
                 declarations are not transitive, so this cannot demote the artifact out of a
                 future SQL uber-jar the way one in the *shaded* module's pom would.
                 Version managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax-grpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The raw StatusRuntimeException path of the error classifier. Test scope, as
                 gax-grpc above. Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- A controllable BatchWrite service whose stream can remain open until the
                 configured GAX deadline ends it. Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- StreamObserver on the in-process BatchWrite service. Test scope, as above.
                 Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- SpannerGrpc and its service base for the controllable in-process BatchWrite
                 service. Test scope; version managed by the libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>grpc-google-cloud-spanner-v1</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- SpannerEmulatorContainer. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster job integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FactoryMocks, for driving the table factory without a planner. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TableEnvironment for the SQL sink integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Planner implementation loaded behind TableEnvironment. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RowData runtime types used by planner-generated test code. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the job integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
