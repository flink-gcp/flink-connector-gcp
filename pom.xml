<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-parent</artifactId>
        <version>2.0.0</version>
    </parent>

    <groupId>io.github.flink-gcp</groupId>
    <artifactId>flink-connector-gcp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Flink Connectors GCP : Parent</name>
    <packaging>pom</packaging>
    <inceptionYear>2026</inceptionYear>

    <url>https://github.com/laughingman7743/flink-connector-gcp</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/laughingman7743/flink-connector-gcp</url>
        <connection>git@github.com:laughingman7743/flink-connector-gcp.git</connection>
        <developerConnection>scm:git:https://github.com/laughingman7743/flink-connector-gcp.git</developerConnection>
    </scm>

    <!-- Not decoration. The ASF parent (org.apache:apache, reached through the Flink
         connector parent) declares its own <organization>, and maven-remote-resources-plugin
         interpolates it into the META-INF/NOTICE it stamps into every module jar. Without
         this block every artifact this project builds claims "Copyright 2026 The Apache
         Software Foundation", which is both wrong and exactly the text the SQL uber-jar's
         ApacheNoticeResourceTransformer would aggregate. -->
    <organization>
        <name>laughingman7743</name>
        <url>https://github.com/laughingman7743</url>
    </organization>

    <modules>
        <module>flink-connector-gcp-bigquery</module>
        <module>flink-connector-gcp-pubsub</module>
        <module>flink-sql-connector-gcp-pubsub</module>
        <module>flink-connector-gcp-cloudtasks</module>
    </modules>

    <properties>
        <flink.parent.artifactId>flink-connector-gcp-parent</flink.parent.artifactId>

        <!-- Main dependencies -->
        <!-- The supported floor. Flink supports the current and the previous minor
             release, so this project supports the same two and compiles against the
             older of them: compiling against the floor and running on a newer minor
             is the direction that works. Moving this is a deliberate change to the
             version matrix in .github/workflows/weekly.yaml, never a dependabot
             minor bump (see the ignore rule in .github/dependabot.yml). -->
        <flink.version>2.2.1</flink.version>
        <google-cloud-libraries-bom.version>26.85.1</google-cloud-libraries-bom.version>
        <!-- Not managed by the Google Cloud libraries BOM -->
        <avro.version>1.12.1</avro.version>
        <!-- JSONObject is the parameter type of the Storage Write API client's
             JsonToProtoMessage, so this has to stay compatible with whatever
             google-cloud-bigquerystorage itself depends on (org.json is in no BOM).
             Note this entry *overrides* that transitive version rather than agreeing
             with it, so a bump there is a silent downgrade here — and our own
             `dependency:tree` cannot show it, since it prints this pin and drops the
             bigquerystorage edge entirely. Check google-cloud-bigquerystorage's own pom
             when the libraries BOM moves. -->
        <org-json.version>20250517</org-json.version>

        <!-- Test dependencies -->
        <assertj.version>3.27.7</assertj.version>
        <junit5.version>5.13.3</junit5.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- protoc, for the test-only .proto sources of the BigQuery module. Not an
             exception to "Google Cloud library versions come only from libraries-bom":
             com.google.protobuf:protoc is not a google-cloud artifact and that BOM does
             not manage it (checked), so there is nothing to inherit. The plugin resolves
             it as an ordinary Maven artifact, so protoc need not be on PATH and CI needs
             no extra tool.

             The constraint on this value runs one way only. protobuf's cross-version
             guarantee is "new gencode + old runtime = never allowed", enforced at runtime
             by a poison pill, while gencode older than the runtime is supported across two
             majors. So this must never be raised above the protobuf-java that libraries-bom
             resolves (4.33.2 today) — but a BOM bump that raises the runtime and leaves this
             behind is the safe direction and needs no action. Getting it wrong fails loudly
             on the first test that touches a generated class, which is why no enforcer rule
             guards it. -->
        <protoc.version>4.33.2</protoc.version>
        <protobuf-maven-plugin.version>5.1.7</protobuf-maven-plugin.version>
        <!-- Resolves the licence of every bundled dependency for the shaded modules,
             so scripts/check-notice.py can hold their hand-written META-INF/NOTICE to
             it. Not managed by any BOM. -->
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${google-cloud-libraries-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-core</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-streaming-java</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-base</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-clients</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-test-utils</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-datagen</artifactId>
                <version>${flink.version}</version>
            </dependency>

            <!-- Table API / SQL. Only flink-table-common is a compile dependency of a
                 connector: it carries the factory SPI, the ability interfaces and the
                 RowData data structures. The rest exist so a module can run SQL in a
                 test — the planner loader is the supported way to get a planner on the
                 test classpath (the connector parent's enforcer bans a direct
                 flink-table-planner dependency outside test scope), and the formats are
                 what a table IT actually encodes with. -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-table-common</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <!-- Managed separately from the jar above: a test-jar is a distinct
                     artifact as far as dependency management is concerned, so it needs
                     its own entry to inherit a version. -->
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-table-common</artifactId>
                <version>${flink.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-table-api-java-bridge</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-table-runtime</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-table-planner-loader</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-json</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-csv</artifactId>
                <version>${flink.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>

            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${org-json.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit5.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Common test dependencies for all modules -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Configured here rather than in the shaded module so every
                     flink-sql-connector-gcp-* inherits one licence vocabulary: two
                     modules disagreeing about how to spell Apache-2.0 would produce
                     two NOTICE styles for one repository. Declared (not just
                     managed) by each module that ships a bundle. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-maven-plugin.version}</version>
                    <configuration>
                        <!-- The bundle is exactly the runtime tree; Flink is provided
                             and the connector's own artifacts are this project's. -->
                        <excludedScopes>test,provided</excludedScopes>
                        <excludedGroups>io.github.flink-gcp</excludedGroups>
                        <!-- Without this the goal leaves an existing THIRD-PARTY.txt
                             alone, so check-notice.py would validate the NOTICE against
                             whatever the last build resolved rather than this one — the
                             exact staleness the check exists to prevent. Found by
                             mutating the report and watching the rebuild not undo it. -->
                        <force>true</force>
                        <!-- Fails when a dependency declares no licence at all, rather
                             than reporting it as a warning and writing "Unknown license"
                             into the report — which check-notice.py would then faithfully
                             demand the NOTICE repeat. (`failIfWarning` covers both this
                             and the blacklist, and is deprecated since 1.14.) -->
                        <failOnMissing>true</failOnMissing>
                        <!-- Artifacts spell one licence many ways: this tree alone has
                             six spellings of Apache-2.0 and two of BSD-3-Clause. The
                             left-hand name is what check-notice.py matches the NOTICE
                             paragraphs against, so a new spelling shows up as a
                             mismatch rather than as a silent extra group. -->
                        <licenseMerges>
                            <licenseMerge>Apache-2.0|Apache 2.0|Apache 2|Apache License V2.0|Apache License, Version 2.0|The Apache License, Version 2.0|The Apache Software License, Version 2.0</licenseMerge>
                            <licenseMerge>BSD-3-Clause|BSD 3-clause|BSD New license</licenseMerge>
                            <licenseMerge>BSD-2-Clause|The BSD 2-Clause License</licenseMerge>
                            <licenseMerge>MIT|MIT license|MIT License|The MIT License</licenseMerge>
                        </licenseMerges>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.commonjava.maven.plugins</groupId>
                <artifactId>directory-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>directories</id>
                        <goals>
                            <goal>directory-of</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <!-- The Flink connector parent hardcodes org.apache.flink as the
                                 groupId of the root project; point it at ours instead. -->
                            <property>rootDir</property>
                            <project>
                                <groupId>io.github.flink-gcp</groupId>
                                <artifactId>${flink.parent.artifactId}</artifactId>
                            </project>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <!-- License header check over the whole tree. The configuration of the Flink
                     connector parent is overridden here because this project is not developed
                     at the ASF: our own files carry the plain Apache-2.0 header, while files
                     copied from Apache projects keep the ASF header. -->
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <excludeSubProjects>false</excludeSubProjects>
                    <numUnapprovedLicenses>0</numUnapprovedLicenses>
                    <licenses>
                        <license implementation="org.apache.rat.analysis.license.SimplePatternBasedLicense">
                            <licenseFamilyCategory>AL2</licenseFamilyCategory>
                            <licenseFamilyName>Apache License 2.0</licenseFamilyName>
                            <notes/>
                            <patterns>
                                <!-- Plain Apache-2.0 header used by this project -->
                                <pattern>Licensed under the Apache License, Version 2.0</pattern>
                                <!-- ASF header kept on files copied from Apache projects -->
                                <pattern>Licensed to the Apache Software Foundation (ASF) under one</pattern>
                            </patterns>
                        </license>
                    </licenses>
                    <licenseFamilies>
                        <licenseFamily implementation="org.apache.rat.license.SimpleLicenseFamily">
                            <familyName>Apache License 2.0</familyName>
                        </licenseFamily>
                    </licenseFamilies>
                    <excludes>
                        <exclude>**/.*</exclude>
                        <exclude>**/.*/**</exclude>
                        <exclude>**/*.log</exclude>
                        <exclude>**/*.iml</exclude>
                        <exclude>**/target/**</exclude>
                        <exclude>**/README.md</exclude>
                        <exclude>**/CLAUDE.md</exclude>
                        <exclude>.github/**</exclude>
                        <exclude>LICENSE</exclude>
                        <exclude>NOTICE</exclude>
                        <exclude>mvnw</exclude>
                        <exclude>mvnw.cmd</exclude>
                        <exclude>mise.toml</exclude>
                        <!-- Untracked personal mise override. rat scans the working
                             tree, so without this a local mise.local.toml fails the
                             license check at the parent module and aborts the build
                             before any test runs, while CI stays green. -->
                        <exclude>mise.local.toml</exclude>
                        <exclude>tools/japicmp-output/**</exclude>
                        <exclude>**/src/test/resources/**</exclude>
                        <!-- The SQL uber-jar's licensing payload. Its NOTICE is a fragment
                             the shade plugin's ApacheNoticeResourceTransformer aggregates,
                             and the licence files are verbatim copies of third-party
                             licences: neither can carry this project's header. The
                             root-relative `NOTICE` exclude above is an Ant pattern that
                             matches only the repository root, so a module path needs its
                             own entry. -->
                        <exclude>**/src/main/resources/META-INF/NOTICE</exclude>
                        <exclude>**/src/main/resources/META-INF/licenses/**</exclude>
                        <!-- The NOTICE's human-written half and the pinned licence
                             sources: a NOTICE fragment cannot carry this project's
                             header, and JSON has no comment syntax rat accepts. -->
                        <exclude>**/NOTICE.template</exclude>
                        <exclude>scripts/licence-sources.json</exclude>
                        <!-- Documentation site: the Go module files are rewritten by
                             `hugo mod` and would not keep a header, the chroma
                             stylesheets are verbatim `hugo gen chromastyles` output
                             (regenerated, not edited — see CLAUDE.md), and
                             public/resources are Hugo build output a local `hugo`
                             run leaves in the tree. -->
                        <exclude>docs/go.mod</exclude>
                        <exclude>docs/go.sum</exclude>
                        <exclude>docs/assets/_chroma-*.scss</exclude>
                        <exclude>docs/public/**</exclude>
                        <exclude>docs/resources/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Resolves Flink SNAPSHOT builds, for the early-warning row of the version
             matrix (`-Pflink-snapshots -Dflink.version=2.4-SNAPSHOT`). The connector
             parent declares a <pluginRepositories> entry only, so snapshot artifacts
             are not otherwise resolvable. Activated explicitly rather than always on:
             an unconditional snapshot repository slows every build down with update
             checks and widens the set of hosts a release build trusts. -->
        <profile>
            <id>flink-snapshots</id>
            <repositories>
                <repository>
                    <id>apache-snapshots</id>
                    <url>https://repository.apache.org/content/repositories/snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
</project>
