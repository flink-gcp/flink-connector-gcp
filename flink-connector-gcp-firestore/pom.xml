<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.flink-gcp</groupId>
        <artifactId>flink-connector-gcp-parent</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-connector-gcp-firestore</artifactId>
    <name>Flink Connectors GCP : Firestore</name>
    <description>Independent Google Cloud Firestore connector for Apache Flink. Not affiliated with the Apache Software Foundation or Google.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Flink (provided at runtime by the Flink cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- The lineage interfaces the sink implements. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-runtime</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- The Table API factory and its dynamic sink. Flink's table runtime supplies this,
                 and the SQL uber jar must not bundle it. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared connector infrastructure: the failure-handler SPI, the option checks, the
             lineage vocabulary and the emulator endpoint. -->
        <dependency>
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Cloud (versions managed by the libraries BOM) -->
        <dependency>
            <!-- The Firestore client. BulkWriter is the write path; Timestamp, GeoPoint and Blob
                 are value types a FirestoreWrite carries, and so part of this module's public
                 API surface. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-firestore</artifactId>
        </dependency>
        <dependency>
            <!-- The Datastore-mode client. Its Batch is the Datastore sink's write path; FullEntity
                 and Key are what a DatastoreMutation carries, and so part of this module's public API
                 surface; Entity is what the Datastore source's deserializer takes. It also brings
                 datastore-v1-proto-client, whose QuerySplitter the source's planner calls: the
                 libraries BOM does not manage that artifact, so it is left to this dependency, which
                 pins the version it was released with, rather than declared at a version kept by
                 hand. -->
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-datastore</artifactId>
        </dependency>
        <dependency>
            <!-- The HTTP transport and credentials adapter the splitter's client is built with,
                 as the client library's own HTTP transport builds it. Versions managed by the
                 libraries BOM. -->
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
        </dependency>
        <dependency>
            <!-- The Datastore protobuf messages: the Datastore sink's lookup builds its
                 LookupRequest itself, so that it makes exactly one call. Version managed by the
                 libraries BOM. -->
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-datastore-v1</artifactId>
        </dependency>
        <dependency>
            <!-- StatusCode for the writer's failure classification. Version managed by the
                 libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>gax</artifactId>
        </dependency>
        <dependency>
            <!-- io.grpc.Status: the library reports a failed write as a BulkWriterException
                 carrying a gRPC status rather than a gax code, and the retry listener and the
                 error classifier read it. Version managed by the libraries BOM. -->
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <!-- The per-write ApiFuture BulkWriter returns, and its callback types. Version
                 managed by the libraries BOM. -->
            <groupId>com.google.api</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <!-- ByteString on the failed-write payload. Version managed by the libraries BOM. -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <!-- Shared test utilities (#27). -->
            <groupId>io.github.flink-gcp</groupId>
            <artifactId>flink-connector-gcp-test-utils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MetricListener, reached through test-utils' TestSinkWriterMetricGroup: that
                 module declares flink-test-utils at provided scope, which is non-transitive
                 by design, so every module using the shared writer stubs declares it too. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FirestoreEmulatorContainer. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Rate-limited source spanning checkpoints in the job integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Local executor backing the MiniCluster job integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FactoryMocks, for driving the table factory without a planner. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TableEnvironment for the SQL sink integration tests. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Planner implementation loaded behind TableEnvironment. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RowData runtime types used by planner-generated test code. -->
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
